{% macro credential_vars() -%}
{%- set username = config.get_value('impacket_legacy_vsphere', 'guest_username', config.get_value('vsphere', 'vsphere_guest_username', '')) -%}
{%- set password = config.get_value('impacket_legacy_vsphere', 'guest_password', config.get_value('vsphere', 'vsphere_guest_password', '')) -%}
{%- if username %} ansible_user={{ username | tojson }}{%- endif -%}
{%- if password %} ansible_password={{ password | tojson }}{%- endif -%}
{%- endmacro %}
[default]
dc2012r2 ansible_host={{ip_range}}.40 dns_domain=impacketlegacy dict_key=dc2012r2{{ credential_vars() }}
win2008r2 ansible_host={{ip_range}}.41 dns_domain=impacketlegacy dict_key=win2008r2{{ credential_vars() }}
win7 ansible_host={{ip_range}}.42 dns_domain=impacketlegacy dict_key=win7{{ credential_vars() }}

[impacket_legacy_dc]
dc2012r2

[impacket_legacy_members]
win2008r2
win7

[impacket_legacy_smb1]
win2008r2
win7

[impacket_legacy_windows:children]
impacket_legacy_dc
impacket_legacy_members

[extensions]
dc2012r2
win2008r2
